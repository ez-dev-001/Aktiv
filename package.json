{
  "name": "aktiv-alb",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/check-groq.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev",
    "prestudio": "node scripts/check-schema.mjs",
    "studio:build": "sanity build",
