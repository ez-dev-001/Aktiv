    "check": "npm run typecheck && npm run check:schema && npm run check:groq",
    "check:schema": "node scripts/check-schema.mjs",
    "check:groq": "node scripts/check-groq.mjs",
    "cleanup:prices": "node scripts/cleanup-prices.mjs",
    "sanity:doctor": "node scripts/doctor.mjs",
    "term:diapazon": "node scripts/replace-term.mjs"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.14.0",
    "next": "latest",
    "next-sanity": "^13.3.4",
    "react": "latest",
    "react-dom": "latest",
    "sanity": "^6.14.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
