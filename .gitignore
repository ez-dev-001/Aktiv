# ── Зависимости и сборка ──
node_modules/
.next/
out/
build/

# ── Секреты ──
# .env.local держит SANITY_API_WRITE_TOKEN — токен НА ЗАПИСЬ.
# Кто его получит, сможет переписать или стереть весь контент в Sanity.
# Три строки, а не одна: .env* не покрывает .env.example, который
# наоборот обязан лежать в репозитории как образец.
.env
.env.local
.env*.local

# ── Служебное, что генерируется само ──
# .sanity/runtime — рабочие файлы студии, пересобираются при каждом
# `npm run studio`. В репозитории они только создают конфликты.
.sanity/
next-env.d.ts
tsconfig.tsbuildinfo
*.log

# ── Хостинги ──
.vercel
.netlify

.DS_Store
